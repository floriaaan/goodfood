{
  "name": "@goodfood/gateway",
  "bin": "dist/index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --minify",
    "build:proto": "sh proto/build-protos.sh",
    "test": "mocha -r ts-node/register src/test/**/*.test.ts",
    "test:coverage": "nyc npm run test",
    "generate:proto": "sh proto/build-protos.sh",
    "swagger": "node src/lib/swagger/swagger.utils.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "axios": "^1.18.1",
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "google-protobuf": "^3.21.4",
    "morgan": "^1.11.0",
    "stripe": "14.11.0",
    "swagger-autogen": "^2.23.7"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/amqplib": "^0.10.8",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/google-protobuf": "^3.15.12",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^18.19.130",
    "@types/sinon": "^17.0.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "chai": "^5.3.3",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "grpc-tools": "^1.13.1",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.14",
    "nyc": "^15.1.0",
    "prettier": "3.0.2",
    "sinon": "^17.0.2",
    "supertest": "^6.3.4",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.0.2",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.2.6"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
